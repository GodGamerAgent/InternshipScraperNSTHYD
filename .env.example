# Copy to .env and load with:  uv run --env-file .env scraper <command>
# Never commit the real .env file.

# SQLite database location (created on first run; parent dir auto-created).
SCRAPER_DB_PATH=data/scraper.db

# Directory holding india_geo.yaml, sources.yaml, scoring.yaml.
SCRAPER_CONFIG_DIR=config

# Transparent User-Agent sent on every request (Phase 2). Include a way to reach you.
SCRAPER_USER_AGENT="india-internship-scraper/0.1 (+https://github.com/your-org/your-repo; contact: you@example.com)"

# Optional: GitHub personal access token (public read-only scope) to raise the
# GitHub REST API rate limit from 60 to 5,000 requests/hour (Phase 4).
GITHUB_TOKEN=

# Directory for ETag / Last-Modified HTTP cache entries (Phase 2). Safe to delete any time.
SCRAPER_HTTP_CACHE_DIR=data/http_cache

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
SCRAPER_LOG_LEVEL=INFO
# Log format: text (key=value, for humans) or json (one object per line, for CI/log tools)
SCRAPER_LOG_FORMAT=text

# Optional: Tier 3 fallback for JS-heavy careers/about pages (Phase 4).
# Leave empty to disable Firecrawl entirely; plain httpx is always tried first.
FIRECRAWL_API_KEY=

# Optional: Brave Search API key for `scraper discover` (automatic ATS board discovery, ADR 007).
# `discover` also works with FIRECRAWL_API_KEY (Firecrawl /search). With neither key set it
# prints a setup hint and makes no network calls. Never scrape a search engine's HTML instead.
BRAVE_SEARCH_API_KEY=
